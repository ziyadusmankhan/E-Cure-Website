# Optional canonical production URL; leave unset for the local demo.
# NEXT_PUBLIC_SITE_URL=https://your-confirmed-domain.example

# Controlled preset: clinical-blue, soft-teal, warm-neutral (rebuild after changing).
# SITE_THEME=clinical-blue
# Public build-time selection: default, general-clinic, home-care, physiotherapy-center.
NEXT_PUBLIC_SITE_PROFILE=default

# Phase 5: server-only runtime connection. Never prefix credentials with NEXT_PUBLIC_.
# Local setup: npm.cmd run db:local:start generates an ignored .env.local safely.
# DATABASE_URL=postgresql://healthcare_app:REPLACE_ME@127.0.0.1:55433/healthcare_development
# Managed Supabase runtime: use healthcare_app.PROJECT_REF and transaction/session pooler.
# DATABASE_URL=postgresql://healthcare_app.PROJECT_REF:REPLACE_ME@POOLER_HOST:6543/postgres

# Migration secret: supply only to migration CLI/CI, outside production runtime env.
# Use direct or session mode (5432), not transaction pooling (6543).
# DIRECT_URL=postgresql://postgres:REPLACE_ME@db.PROJECT_REF.supabase.co:5432/postgres

# Explicit demo-only seed opt-in. Leaves existing reviewed records untouched.
# ALLOW_DEMO_SEED=true

# Optional installed PostgreSQL bin directory for local setup/tests.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
# CI only: dedicated loopback PostgreSQL maintenance server; never a client database.
# TEST_DATABASE_SERVER_URL=postgresql://postgres:CI_ONLY_PASSWORD@127.0.0.1:5432/postgres

# Phase 6. Disabled preserves the frontend-only preview; opt in explicitly.
# SUBMISSIONS_MODE=disabled
# For LOCAL testing only (uses real local database writes with fictional data):
# SUBMISSIONS_MODE=local-test
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# SUBMISSIONS_HMAC_SECRET=REPLACE_WITH_32_RANDOM_BYTES_ENCODED_AS_64_LOWERCASE_HEX_CHARACTERS
# SUBMISSION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local-test startup binds to 127.0.0.1. Never proxy/expose this mode publicly.
# Live mode rejects dummy keys and requires approved non-demo business settings,
# HTTPS origins and real Turnstile credentials before accepting requests.
# TRUSTED_CLIENT_IP_HEADER=none
# Only set cf-connecting-ip or x-real-ip behind a trusted proxy that strips/resets
# that header and blocks direct origin access. x-forwarded-for is not accepted.

# Phase 7: disabled until a real Supabase Auth service is configured and verified.
# ADMIN_AUTH_MODE=disabled
# For local Auth after restarting Windows and starting Docker/Supabase:
# npm.cmd run auth:local:configure (writes only ignored local settings)
# ADMIN_AUTH_MODE=local
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=LOCAL_PUBLIC_KEY_FROM_SUPABASE_STATUS
# ADMIN_SESSION_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_LOWERCASE_HEX_CHARACTERS
# ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# ADMIN_REQUIRE_MFA=true
# Live mode requires HTTPS Auth/origins and MFA. No provider admin/service key is
# needed at runtime. Provisioning keys belong only to trusted CLI processes,
# never .env.local, NEXT_PUBLIC variables, browser code or production app env.

# Phase 8: opt in after migrations and explicit CMS initialization.
# Disabled retains the public profile fixtures without a database.
CMS_MODE=disabled
